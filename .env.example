# ===========================================
# Salvo — Environment Configuration Template
# Copy this file to .env and fill in values
# NEVER commit .env to git
# ===========================================

# ── AI Provider ──────────────────────────
# Provider: groq | openrouter | gemini
LLM_PROVIDER=groq

# Groq Cloud: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (alternative): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google AI Studio (alternative): https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Database ──────────────────────────────
# MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Salvo
MONGODB_DB_NAME=salvo

# ── Razorpay (Test Mode ONLY) ─────────────
# Dashboard: https://dashboard.razorpay.com/app/keys
# IMPORTANT: Only use TEST mode keys (rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_MODE=test

# Razorpay Partner OAuth (if using OAuth flow):
# https://dashboard.razorpay.com/app/partner-configuration
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google OAuth 2.0 ──────────────────────
# Google Cloud Console → APIs & Services → Credentials
# Create OAuth 2.0 Web Application credential
# Add Authorized redirect URIs:
#   - http://localhost:3000/login     (for local development)
#   - https://your-app.vercel.app/login  (for production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret

# ── Frontend ──────────────────────────────
# Used by Vite to expose Google Client ID to browser
# This is the PUBLIC client ID — safe to expose in browser
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Engine Configuration ──────────────────
# Set EXECUTION_SIMULATION=true to prevent real payment retries (recommended for testing)
EXECUTION_SIMULATION=true
MAX_RECOVERY_ATTEMPTS=3

# ── Evaluation & Dataset ──────────────────
DATASET_SEED=salvo-buildathon-v1
DATASET_SIZE=1350
DIAGNOSIS_LIMIT=10
