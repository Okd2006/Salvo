# ─────────────────────────────────────────────
# Salvo — Environment Configuration
# ─────────────────────────────────────────────

# Database: MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=salvo

# AI Provider: Gemini API
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# Payment Infrastructure: Razorpay (Test Mode ONLY — Production disabled)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_MODE=test

# Execution Engine & Safety Limits
EXECUTION_SIMULATION=true
MAX_RECOVERY_ATTEMPTS=3

# Seed & Evaluation Configuration
DATASET_SEED=salvo-buildathon-v1
DATASET_SIZE=1350
DIAGNOSIS_LIMIT=10
