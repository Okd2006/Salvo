# Salvo ? Environment Configuration Example
# ???????????????????????????????????????????????

# AI Provider Configuration (groq | openrouter | gemini)
LLM_PROVIDER=groq

# Groq Configuration (Primary Provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter Configuration (Alternative Provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Database: MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Salvo
MONGODB_DB_NAME=salvo

# AI Provider: Gemini API (Alternative Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Payment Infrastructure: Razorpay (Test Mode ONLY)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_MODE=test

# Execution Engine & Safety Limits
EXECUTION_SIMULATION=true
MAX_RECOVERY_ATTEMPTS=3

# Seed & Evaluation Configuration
DATASET_SEED=salvo-buildathon-v1
DATASET_SIZE=1350
DIAGNOSIS_LIMIT=10
